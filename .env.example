APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# PDF rendering runs on the queue via Laravel Horizon (Redis). The test suite
# overrides this to "sync" in phpunit.xml.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis is pure-PHP (no extension needed); switch to phpredis in production
# for throughput once the extension is installed.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Must exceed the Horizon supervisor timeout (240) so a long PDF render is
# never released back to the queue while it is still being processed.
REDIS_QUEUE_RETRY_AFTER=300

# Comma-separated emails allowed to open the /horizon dashboard in production.
HORIZON_ADMINS=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PDF rendering (Puppeteer + Chrome/Chromium).
# Set PUPPETEER_EXECUTABLE_PATH to the server's Chrome binary, e.g.
#   /usr/bin/google-chrome-stable (Linux) or the macOS Chrome.app path locally.
# Leave it empty to fall back to the Chromium that `npx puppeteer browsers
# install chrome` provisions. Timeout layering: PUPPETEER_TIMEOUT must stay
# below the queue worker timeout and REDIS_QUEUE_RETRY_AFTER (see queue config).
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_TIMEOUT=180
PUPPETEER_NAV_TIMEOUT=60000
PUPPETEER_OUTPUT_DISK=local
PUPPETEER_OUTPUT_DIR=pdfs

VITE_APP_NAME="${APP_NAME}"
